{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.com/project-sentinel/sentinel/docs/contracts/evidence-bundle.schema.json",
  "title": "SentinelEvidenceBundle",
  "description": "Schema for redacted, cryptographic evidence bundles generated by Sentinel upon canary breach detection.",
  "type": "object",
  "required": [
    "schema_version",
    "incident_id",
    "release_id",
    "collected_at",
    "service",
    "candidate_revision",
    "pipeline_id",
    "job_id",
    "commit_sha",
    "breached_thresholds",
    "deployment_options",
    "evaluator_report",
    "revision_logs",
    "git_diff",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "incident_id": {
      "type": "string",
      "pattern": "^inc-[a-zA-Z0-9_-]+$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^rel-[a-zA-Z0-9_-]+$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "service": {
      "type": "string"
    },
    "candidate_revision": {
      "type": "string"
    },
    "pipeline_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$"
    },
    "author": {
      "type": "string"
    },
    "commit_message": {
      "type": "string"
    },
    "breached_thresholds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deployment_options": {
      "type": "object",
      "required": ["recommended", "rationale", "available_strategies"],
      "properties": {
        "recommended": { "type": "string" },
        "rationale": { "type": "string" },
        "available_strategies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["strategy", "name", "recommended", "blast_radius", "rollback_speed_seconds", "zero_downtime"],
            "properties": {
              "strategy": { "type": "string" },
              "name": { "type": "string" },
              "recommended": { "type": "boolean" },
              "blast_radius": { "type": "string" },
              "rollback_speed_seconds": { "type": "number" },
              "zero_downtime": { "type": "boolean" },
              "cost_overhead": { "type": "string" }
            }
          }
        }
      }
    },
    "evaluator_report": {
      "type": "object"
    },
    "revision_logs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "git_diff": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "redactions_count": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
